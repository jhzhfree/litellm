# Existing generic SSO configuration; no new login implementation.
GENERIC_CLIENT_ID=gateway-console
GENERIC_CLIENT_SECRET=
GENERIC_AUTHORIZATION_ENDPOINT=http://127.0.0.1:18080/realms/company/protocol/openid-connect/auth
GENERIC_TOKEN_ENDPOINT=http://127.0.0.1:18080/realms/company/protocol/openid-connect/token
GENERIC_USERINFO_ENDPOINT=http://127.0.0.1:18080/realms/company/protocol/openid-connect/userinfo
GENERIC_CLIENT_USE_PKCE=true
PKCE_STRICT_CACHE_MISS=true
GENERIC_SCOPE=openid profile email
GENERIC_USER_ID_ATTRIBUTE=sub
GENERIC_USER_DISPLAY_NAME_ATTRIBUTE=name
GENERIC_USER_EMAIL_ATTRIBUTE=email
PROXY_BASE_URL=http://127.0.0.1:4001
JWT_ISSUER=http://127.0.0.1:18080/realms/company
JWT_AUDIENCE=ai-governance-gateway
JWT_PUBLIC_KEY_URL=http://127.0.0.1:18080/realms/company/protocol/openid-connect/certs
