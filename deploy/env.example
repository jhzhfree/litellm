# 复制为 deploy/.env 后按需修改，再执行 bash deploy/prepare.sh
# cp deploy/env.example deploy/.env

# ── 全部项均有开箱即用的默认值，留空即用默认 ──────────────
# 默认管理员口令（部署后请务必修改，尤其暴露公网时）：
LITELLM_MASTER_KEY=sk-ai-gw-default
UI_USERNAME=admin
UI_PASSWORD=AI-Tokengw@2026

# 数据库密码（core 与 db 使用同一个值）
DB_PASSWORD=dbpassword9090

# 默认模型 deepseek-chat 的密钥（不配置则模型不可调用，仍可在 UI 添加其它模型）
DEEPSEEK_API_KEY=

# 端口映射（可选）
CORE_PORT=4000
MONITOR_PORT=9090
